{
    "manifest_version": 3,
    "name": "AttendSync",
    "version": "0.1.0",
    "description": "A Chrome extension that helps teachers automate attendance reporting.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "AttendSync"
    }
}